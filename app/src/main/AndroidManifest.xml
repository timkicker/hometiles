<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- a launcher may see the list of startable apps (android 11+ package visibility).
         no QUERY_ALL_PACKAGES needed. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <!-- only to show reception and network type on the signal tile. reading only: HomeTiles
         dials nothing through it and registers nowhere. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.WRITE_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- only for the favourite mark; creating and editing contacts is the system app's job. -->
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- only for the new-message notice, and only needed from android 13 on. on the target
         device (android 11) the system grants it at install time. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- for the full screen notice on a new message (PLAN.md 4.7). it is off by default;
         without this declaration it would appear silently as an ordinary notice. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <application
        android:name=".HomeTilesApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.HomeTiles">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:configChanges="keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize"
            android:windowSoftInputMode="adjustPan"
            android:theme="@style/Theme.HomeTiles">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>




        <activity
            android:name=".tiles.TileEditorActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.HomeTiles" />

        <!-- the call screen. showWhenLocked so a call can be worked on a locked screen -
             otherwise nobody reaches the answer button. -->
        <activity
            android:name=".phone.InCallActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.HomeTiles" />

        <!-- the four components a default sms app must have. with one missing HomeTiles does
             not appear in the chooser at all, regardless of whether it would work. see
             SmsComponents.kt. -->
        <receiver
            android:name=".sms.SmsDeliverReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".sms.WapPushDeliverReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_WAP_PUSH">
            <intent-filter>
                <action android:name="android.provider.Telephony.WAP_PUSH_DELIVER" />
                <data android:mimeType="application/vnd.wap.mms-message" />
            </intent-filter>
        </receiver>

        <service
            android:name=".sms.RespondViaMessageService"
            android:exported="true"
            android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE">
            <intent-filter>
                <action android:name="android.intent.action.RESPOND_VIA_MESSAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </service>

        <activity
            android:name=".sms.SmsActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.HomeTiles">
            <intent-filter>
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </activity>

        <!-- the network's receipt for a sent message. not exported: the system sends the
             broadcast to exactly this PendingIntent. -->
        <receiver
            android:name=".sms.SmsSentReceiver"
            android:exported="false" />

        <!-- rejects blocked numbers before android rings. only the default phone app is
             asked; without the role the fallback in BigInCallService takes over. -->
        <service
            android:name=".phone.CallScreening"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <service
            android:name=".phone.BigInCallService"
            android:exported="true"
            android:permission="android.permission.BIND_INCALL_SERVICE">
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_UI"
                android:value="true" />
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>

        <activity
            android:name=".toggles.SosActivity"
            android:exported="false"
            android:theme="@style/Theme.HomeTiles" />

        <!-- for the phone role android demands an ACTION_DIAL entry. without it HomeTiles does
             not show up in the default phone app chooser at all. -->
        <activity
            android:name=".phone.DialerActivity"
            android:exported="true"
            android:theme="@style/Theme.HomeTiles">
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tel" />
            </intent-filter>
        </activity>

        <activity
            android:name=".contacts.ContactsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.HomeTiles" />

        <activity
            android:name=".apps.AppDrawerActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.HomeTiles" />

        <!-- the waiting notice is opened through an intent: `Notice` lives in the design
             system and must not know the activity by name. see dev.kicker.hometiles.ui.Notice.ACTION. -->
        <activity
            android:name=".ui.NoticeActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.HomeTiles">
            <intent-filter>
                <action android:name="dev.kicker.hometiles.action.NOTICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- opening a backup file from outside: file manager, cloud, mail attachment. -->
        <activity
            android:name=".settings.ImportActivity"
            android:exported="true"
            android:theme="@style/Theme.HomeTiles">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/json" />
            </intent-filter>
        </activity>

        <activity
            android:name=".wizard.WizardActivity"
            android:exported="false"
            android:theme="@style/Theme.HomeTiles" />

        <!-- a jump to a subpage goes through this intent instead of the class: otherwise
             every screen that jumps there knows the settings by name. not exported - the
             intent is kept inside the app with setPackage. see dev.kicker.hometiles.ui.SettingsLink. -->
        <activity
            android:name=".settings.SettingsActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.HomeTiles">
            <intent-filter>
                <action android:name="dev.kicker.hometiles.action.SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- the alarm for the repeated reminder about unread messages. not exported: only
             the app's own alarm triggers it. -->
        <receiver
            android:name=".sms.MessageReminderReceiver"
            android:exported="false" />

        <service
            android:name=".notify.BigNotificationListener"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
