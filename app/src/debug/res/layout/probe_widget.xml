<?xml version="1.0" encoding="utf-8"?>
<!-- debug build only, see ProbeWidgetProvider. the lint warnings are switched off because no
     user ever sees this: it draws inside the host's tile, not over a theme, and the label is
     only for whoever runs the probe. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF1E4620"
    android:gravity="center"
    android:text="Probe widget"
    android:textColor="#FFFFFFFF"
    android:textSize="20sp"
    tools:ignore="Overdraw,HardcodedText" />
